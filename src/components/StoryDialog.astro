<dialog class="story-dialog" id="momentDialog" aria-labelledby="dialogTitle">
  <div class="dialog-inner" data-lenis-prevent>
    <button class="dialog-close" type="button" aria-label="Tutup cerita">×</button>
    <time class="meta" id="dialogDate"></time>
    <h2 id="dialogTitle">Judul momen</h2>
    <p id="dialogStory"></p>
    <p class="meta dialog-signoff">SEBUAH CATATAN DARI KITA</p>
  </div>
</dialog>
<dialog class="story-dialog" id="videoDialog" aria-labelledby="videoDialogTitle">
  <div class="dialog-inner" data-lenis-prevent>
    <button class="dialog-close" type="button" aria-label="Tutup video">×</button>
    <span class="meta">VIDEO CERITA</span>
    <h2 id="videoDialogTitle">Video kenangan</h2>
    <div id="storyVideoMount"></div>
    <p id="videoTranscript"></p>
  </div>
</dialog>
